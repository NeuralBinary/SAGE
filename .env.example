# SAGE local adapter settings
SAGE_URL=http://127.0.0.1:8080
SAGE_AGENT_ID=agent-a
SAGE_WORKSPACE=default
# Leave blank for the local quick start. Set this when the server requires auth.
SAGE_API_KEY=

# Production Compose example (replace every value before use)
SAGE_POSTGRES_PASSWORD=replace-with-a-long-random-password
SAGE_DATABASE_URL=postgresql+psycopg://sage:replace-with-a-long-random-password@postgres:5432/sage
SAGE_API_KEYS=replace-with-a-service-key-at-least-32-characters
SAGE_ALLOWED_HOSTS=localhost,127.0.0.1
